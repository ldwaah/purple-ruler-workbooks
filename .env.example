# Copy to .env.local and fill from Supabase → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Public app URL for teacher magic links (copy buttons, seed-tokens)
NEXT_PUBLIC_APP_URL=https://purpleruler.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Optional: Supabase → Settings → Database → Connection string (URI)
# Used only if you run: psql "$DATABASE_URL" -f supabase/bootstrap.sql
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
